{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: Run Automated Suite (npm test)",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Watch Mode (node --test --watch)",
      "type": "shell",
      "command": "npm run test:watch",
      "isBackground": true,
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview: Serve Studio Locally (HTTP :8080)",
      "type": "shell",
      "command": "npm run serve",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "GitHub: Check Release & Workflow Status",
      "type": "shell",
      "command": "gh release view --repo RajwanYair/barcode-label-studio --json tagName,name,publishedAt,targetCommitish,url,assets && gh run list --repo RajwanYair/barcode-label-studio --limit 6",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
